Option Explicit

' ================================================================
' SUIVI DES SUSPENS - SGCI
' Feuilles par index : 1=CONFIG 2=Accueil 3=DonneesAccess
'                      4=Suspens 5=Statistiques 6=Graphiques
'                      7=Mensuel 8=Parametres 9=VBASetup
' ================================================================

Function ConnecterAccess(sPath As String) As Object
    Dim cn As Object
    Dim providers(1) As String
    providers(0) = "Microsoft.ACE.OLEDB.16.0"
    providers(1) = "Microsoft.ACE.OLEDB.12.0"
    Dim p As Integer
    For p = 0 To 1
        Set cn = CreateObject("ADODB.Connection")
        cn.ConnectionString = "Provider=" & providers(p) & _
                              ";Data Source=" & sPath & _
                              ";Persist Security Info=False;"
        On Error Resume Next
        Err.Clear
        cn.Open
        If Err.Number = 0 Then
            On Error GoTo 0
            Set ConnecterAccess = cn
            Exit Function
        End If
        On Error GoTo 0
        Set cn = Nothing
    Next p
    Set ConnecterAccess = Nothing
End Function

Sub ActualiserDepuisAccess()

    Dim sPath    As String
    Dim conn     As Object
    Dim rs       As Object
    Dim rsAn     As Object
    Dim wsDat    As Worksheet
    Dim wsSus    As Worksheet
    Dim wsCfg    As Worksheet
    Dim wsPrm    As Worksheet
    Dim i        As Long
    Dim lastRow  As Long

    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual

    On Error GoTo ErrHandler

    Set wsCfg = ThisWorkbook.Sheets(1)
    Set wsDat = ThisWorkbook.Sheets(3)
    Set wsSus = ThisWorkbook.Sheets(4)
    Set wsPrm = ThisWorkbook.Sheets(8)

    ' -- 1. Chemin Access --
    sPath = Trim(wsCfg.Range("B1").Value)
    If sPath = "" Then
        MsgBox "Chemin Access vide. Renseignez CONFIG > B1.", vbExclamation
        GoTo Cleanup
    End If
    If Dir(sPath) = "" Then
        MsgBox "Fichier introuvable :" & vbCrLf & sPath, vbCritical
        GoTo Cleanup
    End If

    ' -- 2. Connexion --
    Set conn = ConnecterAccess(sPath)
    If conn Is Nothing Then
        MsgBox "Impossible de se connecter a Access." & vbCrLf & vbCrLf & _
               "Lancez la macro DiagnosticProviders pour identifier le probleme.", _
               vbCritical
        GoTo Cleanup
    End If

    ' -- 3. Analystes distincts -> Parametres col C --
    Dim lastAnRow As Long
    lastAnRow = wsPrm.Cells(wsPrm.Rows.Count, 3).End(xlUp).Row
    If lastAnRow >= 2 Then wsPrm.Range("C2:C" & lastAnRow).ClearContents

    Set rsAn = CreateObject("ADODB.Recordset")
    rsAn.Open "SELECT DISTINCT [ANALYSTE] FROM [DATABASE] " & _
              "WHERE [ANALYSTE] IS NOT NULL AND [ANALYSTE] <> '' " & _
              "ORDER BY [ANALYSTE]", conn, 1, 3

    Dim anRow As Long
    anRow = 2
    Do While Not rsAn.EOF
        Dim anName As String
        anName = Trim(CStr(rsAn.Fields(0).Value))
        If anName <> "" Then
            wsPrm.Cells(anRow, 3).Value = anName
            wsPrm.Cells(anRow, 3).Font.Name = "Arial"
            wsPrm.Cells(anRow, 3).Font.Size = 10
            If anRow Mod 2 = 0 Then
                wsPrm.Cells(anRow, 3).Interior.Color = RGB(245, 247, 250)
            Else
                wsPrm.Cells(anRow, 3).Interior.Color = RGB(255, 255, 255)
            End If
            anRow = anRow + 1
        End If
        rsAn.MoveNext
    Loop
    rsAn.Close
    Dim nbAnalystes As Long
    nbAnalystes = anRow - 2

    ' Validation liste deroulante col E
    On Error Resume Next
    wsSus.Range("E3:E202").Validation.Delete
    If nbAnalystes > 0 Then
        With wsSus.Range("E3:E202").Validation
            .Add Type:=3, AlertStyle:=1, Operator:=1, _
                 Formula1:="=Parametres!$C$2:$C$" & (anRow - 1)
            .IgnoreBlank = True
            .InCellDropdown = True
        End With
    End If
    On Error GoTo ErrHandler

    ' -- 4. Requete principale --
    ' On utilise SELECT * pour eviter les erreurs de noms de colonnes
    ' puis on lit les champs par leur nom depuis le recordset
    Set rs = CreateObject("ADODB.Recordset")
    rs.Open "SELECT * FROM [DATABASE] WHERE [ETAT] = 'En suspens' " & _
            "ORDER BY [IDSG]", conn, 1, 3

    ' -- 5. Ecriture dans Donnees Access --
    Dim lastDat As Long
    lastDat = wsDat.Cells(wsDat.Rows.Count, 1).End(xlUp).Row
    If lastDat > 2 Then wsDat.Rows("3:" & lastDat).ClearContents

    If rs.EOF Then
        MsgBox "Aucun dossier avec ETAT = 'En suspens' trouve.", vbInformation
        wsCfg.Range("B4").Value = "Connecte - aucun suspens"
        GoTo Cleanup
    End If

    ' Ecrire les colonnes utiles une par une depuis le recordset
    ' pour eviter toute erreur de nom de champ
    Dim totalImport As Long
    totalImport = 0
    Dim curRow As Long
    curRow = 3

    Dim fIDSG     As String
    Dim fRCT      As String
    Dim fClient   As String
    Dim fEtat     As String
    Dim fAnalyste As String
    Dim fDemande  As String
    Dim fDateRec  As Variant

    Do While Not rs.EOF
        ' Lire chaque champ avec gestion d erreur individuelle
        On Error Resume Next
        fIDSG     = Trim(CStr(rs.Fields("IDSG").Value))
        fRCT      = Trim(CStr(rs.Fields("RCT").Value))
        fClient   = Trim(CStr(rs.Fields("CLIENT").Value))
        fEtat     = Trim(CStr(rs.Fields("ETAT").Value))
        fAnalyste = Trim(CStr(rs.Fields("ANALYSTE").Value))
        fDemande  = Trim(CStr(rs.Fields("DEMANDE").Value))
        fDateRec  = rs.Fields("DATE DE RECEPTION").Value
        On Error GoTo ErrHandler

        ' Ecrire dans Donnees Access
        wsDat.Cells(curRow, 1).Value = fIDSG
        wsDat.Cells(curRow, 2).Value = fRCT
        wsDat.Cells(curRow, 3).Value = fClient
        wsDat.Cells(curRow, 4).Value = fEtat
        wsDat.Cells(curRow, 5).Value = fAnalyste
        wsDat.Cells(curRow, 6).Value = fDemande
        If IsDate(fDateRec) Then
            wsDat.Cells(curRow, 7).Value = CDate(fDateRec)
            wsDat.Cells(curRow, 7).NumberFormat = "DD/MM/YYYY"
        End If

        ' Zebra
        If curRow Mod 2 = 0 Then
            wsDat.Rows(curRow).Interior.Color = RGB(245, 247, 250)
        Else
            wsDat.Rows(curRow).Interior.Color = RGB(255, 255, 255)
        End If
        wsDat.Rows(curRow).RowHeight = 20

        curRow = curRow + 1
        totalImport = totalImport + 1
        rs.MoveNext
    Loop
    rs.Close

    ' -- 6. Synchronisation Suspens --
    Dim dictStatut  As Object
    Dim dictRaison1 As Object
    Dim dictRaison2 As Object
    Dim dictRaison3 As Object
    Dim dictComment As Object
    Set dictStatut  = CreateObject("Scripting.Dictionary")
    Set dictRaison1 = CreateObject("Scripting.Dictionary")
    Set dictRaison2 = CreateObject("Scripting.Dictionary")
    Set dictRaison3 = CreateObject("Scripting.Dictionary")
    Set dictComment = CreateObject("Scripting.Dictionary")

    Dim susLastRow As Long
    susLastRow = wsSus.Cells(wsSus.Rows.Count, 2).End(xlUp).Row
    Dim r As Long
    For r = 3 To susLastRow
        Dim idsgKey As String
        idsgKey = Trim(CStr(wsSus.Cells(r, 2).Value))
        If idsgKey <> "" Then
            dictStatut(idsgKey)  = wsSus.Cells(r, 8).Value
            dictRaison1(idsgKey) = wsSus.Cells(r, 10).Value
            dictRaison2(idsgKey) = wsSus.Cells(r, 11).Value
            dictRaison3(idsgKey) = wsSus.Cells(r, 12).Value
            dictComment(idsgKey) = wsSus.Cells(r, 13).Value
        End If
    Next r

    ' Effacer cellule par cellule (evite erreur 1004 sur tableau structure)
    Dim clearTo As Long
    clearTo = Application.Max(susLastRow, totalImport + 2)
    For r = 3 To clearTo
        wsSus.Cells(r, 2).Value  = ""
        wsSus.Cells(r, 3).Value  = ""
        wsSus.Cells(r, 4).Value  = ""
        wsSus.Cells(r, 5).Value  = ""
        wsSus.Cells(r, 6).Value  = ""
        wsSus.Cells(r, 7).Value  = ""
        wsSus.Cells(r, 8).Value  = ""
        wsSus.Cells(r, 14).Value = ""
    Next r

    ' Reecrire depuis wsDat
    For i = 1 To totalImport
        Dim rSus As Long
        rSus = i + 2
        Dim sIDSG As String
        sIDSG = Trim(CStr(wsDat.Cells(i + 2, 1).Value))

        wsSus.Cells(rSus, 2).Value  = sIDSG
        wsSus.Cells(rSus, 3).Value  = wsDat.Cells(i + 2, 2).Value
        wsSus.Cells(rSus, 4).Value  = wsDat.Cells(i + 2, 3).Value
        wsSus.Cells(rSus, 5).Value  = wsDat.Cells(i + 2, 5).Value
        wsSus.Cells(rSus, 6).Value  = wsDat.Cells(i + 2, 4).Value
        wsSus.Cells(rSus, 14).Value = wsDat.Cells(i + 2, 6).Value

        Dim dRec As Variant
        dRec = wsDat.Cells(i + 2, 7).Value
        If IsDate(dRec) Then
            wsSus.Cells(rSus, 7).Value = CDate(dRec)
            wsSus.Cells(rSus, 7).NumberFormat = "DD/MM/YYYY"
        End If

        If dictStatut.Exists(sIDSG) Then
            wsSus.Cells(rSus, 8).Value  = dictStatut(sIDSG)
            wsSus.Cells(rSus, 10).Value = dictRaison1(sIDSG)
            wsSus.Cells(rSus, 11).Value = dictRaison2(sIDSG)
            wsSus.Cells(rSus, 12).Value = dictRaison3(sIDSG)
            wsSus.Cells(rSus, 13).Value = dictComment(sIDSG)
        Else
            wsSus.Cells(rSus, 8).Value = "En cours"
        End If
    Next i

    ' -- 7. MAJ CONFIG --
    wsCfg.Range("B3").Value = Now()
    wsCfg.Range("B4").Value = "Connecte - " & totalImport & " dossier(s) | " & nbAnalystes & " analyste(s)"

    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True

    MsgBox "Actualisation terminee !" & vbCrLf & vbCrLf & _
           totalImport & " dossier(s) importes." & vbCrLf & _
           nbAnalystes & " analyste(s) detectes.", _
           vbInformation, "Suivi Suspens SGCI"
    Exit Sub

ErrHandler:
    wsCfg.Range("B4").Value = "Erreur n" & Err.Number & " : " & Err.Description
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
    MsgBox "Erreur n" & Err.Number & " :" & vbCrLf & vbCrLf & _
           Err.Description, vbCritical, "Erreur VBA"

Cleanup:
    On Error Resume Next
    If Not rsAn Is Nothing Then If rsAn.State = 1 Then rsAn.Close
    If Not rs   Is Nothing Then If rs.State   = 1 Then rs.Close
    If Not conn Is Nothing Then If conn.State = 1 Then conn.Close
    Set rsAn = Nothing : Set rs = Nothing : Set conn = Nothing
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
End Sub

' -- Diagnostic drivers OLEDB --
Sub DiagnosticProviders()
    Dim msg As String
    msg = "Test drivers OLEDB :" & vbCrLf & vbCrLf
    Dim providers(1) As String
    providers(0) = "Microsoft.ACE.OLEDB.16.0"
    providers(1) = "Microsoft.ACE.OLEDB.12.0"
    Dim p As Integer
    For p = 0 To 1
        Dim cn As Object
        Set cn = CreateObject("ADODB.Connection")
        cn.ConnectionString = "Provider=" & providers(p) & ";Data Source=C:\test.accdb;"
        On Error Resume Next
        Err.Clear
        cn.Open
        Dim sErr As String : sErr = Err.Description
        Dim nErr As Long   : nErr = Err.Number
        On Error GoTo 0
        If cn.State = 1 Then cn.Close
        If nErr = 0 Or InStr(LCase(sErr), "find") > 0 Or InStr(LCase(sErr), "trouv") > 0 Then
            msg = msg & "  [OK] " & providers(p) & vbCrLf
        Else
            msg = msg & "  [X]  " & providers(p) & " -> " & sErr & vbCrLf
        End If
        Set cn = Nothing
    Next p
    msg = msg & vbCrLf & "Chemin : " & ThisWorkbook.Sheets(1).Range("B1").Value
    MsgBox msg, vbInformation, "Diagnostic OLEDB"
End Sub

Sub ConfigurerCheminAccess()
    Dim wsCfg As Worksheet
    Set wsCfg = ThisWorkbook.Sheets(1)
    Dim sPath As String
    sPath = InputBox("Chemin du fichier Access :" & vbCrLf & _
                     "Actuel : " & wsCfg.Range("B1").Value, _
                     "Configurer", wsCfg.Range("B1").Value)
    If sPath = "" Then Exit Sub
    wsCfg.Range("B1").Value = sPath
    MsgBox "Chemin enregistre.", vbInformation
End Sub
