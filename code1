Option Explicit

' ================================================================
' SUIVI DES SUSPENS - SGCI
' Feuilles par index : 1=CONFIG 2=Accueil 3=DonneesAccess
'                      4=Suspens 5=Statistiques 6=Graphiques
'                      7=Mensuel 8=Parametres 9=VBASetup
' ================================================================

Sub ActualiserDepuisAccess()

    Dim sPath    As String
    Dim conn     As Object
    Dim rs       As Object
    Dim rsAn     As Object
    Dim wsDat    As Worksheet
    Dim wsSus    As Worksheet
    Dim wsCfg    As Worksheet
    Dim wsPrm    As Worksheet
    Dim i        As Long
    Dim lastRow  As Long

    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual

    On Error GoTo ErrHandler

    Set wsCfg = ThisWorkbook.Sheets(1)
    Set wsDat = ThisWorkbook.Sheets(3)
    Set wsSus = ThisWorkbook.Sheets(4)
    Set wsPrm = ThisWorkbook.Sheets(8)

    ' -- 1. Chemin Access --
    sPath = Trim(wsCfg.Range("B1").Value)

    If sPath = "" Then
        MsgBox "Chemin Access vide. Renseignez CONFIG > B1.", vbExclamation
        GoTo Cleanup
    End If

    ' Verifier existence du fichier
    If Dir(sPath) = "" Then
        MsgBox "Fichier introuvable :" & vbCrLf & sPath & vbCrLf & vbCrLf & _
               "Verifiez :" & vbCrLf & _
               "  - Etes-vous connecte au reseau S:\" & vbCrLf & _
               "  - Le nom du fichier est exact (majuscules, extension .accdb)", _
               vbCritical, "Fichier non trouve"
        GoTo Cleanup
    End If

    ' -- 2. Connexion ADODB --
    ' Test du provider disponible
    Dim sProvider As String
    On Error Resume Next
    Set conn = CreateObject("ADODB.Connection")
    If Err.Number <> 0 Then
        MsgBox "ADODB non disponible : " & Err.Description, vbCritical
        GoTo Cleanup
    End If
    On Error GoTo ErrHandler

    ' Essai avec ACE 16.0 d abord, puis 12.0
    Dim sConn As String
    sConn = "Provider=Microsoft.ACE.OLEDB.16.0;Data Source=" & sPath & ";Persist Security Info=False;"
    On Error Resume Next
    conn.Open sConn
    If Err.Number <> 0 Then
        Err.Clear
        conn.Close
        sConn = "Provider=Microsoft.ACE.OLEDB.12.0;Data Source=" & sPath & ";Persist Security Info=False;"
        conn.Open sConn
        If Err.Number <> 0 Then
            MsgBox "Impossible de se connecter a Access." & vbCrLf & vbCrLf & _
                   "Erreur : " & Err.Description & vbCrLf & vbCrLf & _
                   "Verifiez que Microsoft Access est bien installe et que" & vbCrLf & _
                   "le fichier n est pas deja ouvert par quelqu un d autre.", _
                   vbCritical, "Erreur connexion"
            GoTo Cleanup
        End If
    End If
    On Error GoTo ErrHandler

    ' -- 3. Analystes distincts depuis Access -> Parametres col C --
    Dim lastAnRow As Long
    lastAnRow = wsPrm.Cells(wsPrm.Rows.Count, 3).End(xlUp).Row
    If lastAnRow >= 2 Then wsPrm.Range("C2:C" & lastAnRow).ClearContents

    Dim sqlAn As String
    sqlAn = "SELECT DISTINCT [ANALYSTE] FROM [DATABASE] " & _
            "WHERE [ANALYSTE] IS NOT NULL AND [ANALYSTE] <> '' " & _
            "ORDER BY [ANALYSTE]"

    Set rsAn = CreateObject("ADODB.Recordset")
    rsAn.Open sqlAn, conn, 1, 3

    Dim anRow As Long
    anRow = 2
    Do While Not rsAn.EOF
        Dim anName As String
        anName = Trim(CStr(rsAn.Fields(0).Value))
        If anName <> "" Then
            wsPrm.Cells(anRow, 3).Value = anName
            wsPrm.Cells(anRow, 3).Font.Name = "Arial"
            wsPrm.Cells(anRow, 3).Font.Size = 10
            If anRow Mod 2 = 0 Then
                wsPrm.Cells(anRow, 3).Interior.Color = RGB(245, 247, 250)
            Else
                wsPrm.Cells(anRow, 3).Interior.Color = RGB(255, 255, 255)
            End If
            anRow = anRow + 1
        End If
        rsAn.MoveNext
    Loop
    rsAn.Close

    Dim nbAnalystes As Long
    nbAnalystes = anRow - 2

    ' Recreer la validation liste deroulante col E de Suspens
    wsSus.Range("E3:E202").Validation.Delete
    If nbAnalystes > 0 Then
        With wsSus.Range("E3:E202").Validation
            .Add Type:=3, AlertStyle:=1, Operator:=1, _
                 Formula1:="=Parametres!$C$2:$C$" & (anRow - 1)
            .IgnoreBlank = True
            .InCellDropdown = True
            .ShowInput = False
            .ShowError = False
        End With
    End If

    ' -- 4. Requete principale : dossiers En suspens --
    Dim sql As String
    sql = "SELECT [IDSG],[RCT],[CLIENT],[ETAT],[ANALYSTE],[DEMANDE]," & _
          "[DATE DE RECEPTION],[DATE D'ATTRIBUTION],[DATE DE PRISE EN CHARGE]," & _
          "[DATE D'ENVOIE AU SIGNATAIRE],[SIGNATAIRE],[DATE DE SIGNATURE]," & _
          "[ENVOIE MARCHE 1],[RETOUR MARCHE 1],[ENVOIE MARCHE 2],[RETOUR MARCHE 2]," & _
          "[SECTEUR],[NOTE],[LAD],[MXOF],[DECISION],[DELAIS ANALYSTE],[DELAI TOTAL] " & _
          "FROM [DATABASE] " & _
          "WHERE [ETAT] = 'En suspens' " & _
          "ORDER BY [DATE DE RECEPTION] DESC"

    Set rs = CreateObject("ADODB.Recordset")
    rs.Open sql, conn, 1, 3

    ' -- 5. Ecriture dans Donnees Access --
    Dim lastDat As Long
    lastDat = wsDat.Cells(wsDat.Rows.Count, 1).End(xlUp).Row
    If lastDat > 2 Then wsDat.Rows("3:" & lastDat).ClearContents

    If rs.EOF Then
        MsgBox "Aucun dossier En suspens trouve dans la table DATABASE.", _
               vbInformation, "Resultat vide"
        wsCfg.Range("B4").Value = "Aucun suspens trouve"
        GoTo Cleanup
    End If

    wsDat.Cells(3, 1).CopyFromRecordset rs
    rs.Close

    lastRow = wsDat.Cells(wsDat.Rows.Count, 1).End(xlUp).Row

    ' Formater les dates
    Dim dateCols As Variant
    dateCols = Array(7, 8, 9, 10, 12, 13, 14, 15, 16)
    Dim dc As Variant
    For Each dc In dateCols
        wsDat.Range(wsDat.Cells(3, dc), wsDat.Cells(lastRow, dc)).NumberFormat = "DD/MM/YYYY"
    Next dc

    ' Zebra striping
    Dim r As Long
    For r = 3 To lastRow
        If r Mod 2 = 0 Then
            wsDat.Rows(r).Interior.Color = RGB(245, 247, 250)
        Else
            wsDat.Rows(r).Interior.Color = RGB(255, 255, 255)
        End If
        wsDat.Rows(r).RowHeight = 20
    Next r

    Dim totalImport As Long
    totalImport = lastRow - 2

    ' -- 6. Synchronisation Suspens --
    Dim dictStatut  As Object
    Dim dictRaison1 As Object
    Dim dictRaison2 As Object
    Dim dictRaison3 As Object
    Dim dictComment As Object

    Set dictStatut  = CreateObject("Scripting.Dictionary")
    Set dictRaison1 = CreateObject("Scripting.Dictionary")
    Set dictRaison2 = CreateObject("Scripting.Dictionary")
    Set dictRaison3 = CreateObject("Scripting.Dictionary")
    Set dictComment = CreateObject("Scripting.Dictionary")

    Dim susLastRow As Long
    susLastRow = wsSus.Cells(wsSus.Rows.Count, 2).End(xlUp).Row

    For r = 3 To susLastRow
        Dim idsgKey As String
        idsgKey = Trim(CStr(wsSus.Cells(r, 2).Value))
        If idsgKey <> "" Then
            dictStatut(idsgKey)  = wsSus.Cells(r, 8).Value
            dictRaison1(idsgKey) = wsSus.Cells(r, 10).Value
            dictRaison2(idsgKey) = wsSus.Cells(r, 11).Value
            dictRaison3(idsgKey) = wsSus.Cells(r, 12).Value
            dictComment(idsgKey) = wsSus.Cells(r, 13).Value
        End If
    Next r

    Dim clearTo As Long
    clearTo = Application.Max(susLastRow, totalImport + 2)
    If clearTo >= 3 Then wsSus.Range("B3:N" & clearTo).ClearContents

    For i = 1 To totalImport
        Dim rSus As Long
        rSus = i + 2

        Dim sIDSG As String
        sIDSG = Trim(CStr(wsDat.Cells(i + 2, 1).Value))

        wsSus.Cells(rSus, 2).Value  = sIDSG
        wsSus.Cells(rSus, 3).Value  = wsDat.Cells(i + 2, 2).Value
        wsSus.Cells(rSus, 4).Value  = wsDat.Cells(i + 2, 3).Value
        wsSus.Cells(rSus, 5).Value  = wsDat.Cells(i + 2, 5).Value
        wsSus.Cells(rSus, 6).Value  = wsDat.Cells(i + 2, 4).Value
        wsSus.Cells(rSus, 14).Value = wsDat.Cells(i + 2, 6).Value

        Dim dRec As Variant
        dRec = wsDat.Cells(i + 2, 7).Value
        If IsDate(dRec) Then
            wsSus.Cells(rSus, 7).Value = CDate(dRec)
            wsSus.Cells(rSus, 7).NumberFormat = "DD/MM/YYYY"
        End If

        If dictStatut.Exists(sIDSG) Then
            wsSus.Cells(rSus, 8).Value  = dictStatut(sIDSG)
            wsSus.Cells(rSus, 10).Value = dictRaison1(sIDSG)
            wsSus.Cells(rSus, 11).Value = dictRaison2(sIDSG)
            wsSus.Cells(rSus, 12).Value = dictRaison3(sIDSG)
            wsSus.Cells(rSus, 13).Value = dictComment(sIDSG)
        Else
            wsSus.Cells(rSus, 8).Value = "En cours"
        End If
    Next i

    ' -- 7. MAJ CONFIG --
    wsCfg.Range("B3").Value = Now()
    wsCfg.Range("B4").Value = "Connecte - " & totalImport & " dossier(s) | " & nbAnalystes & " analyste(s)"

    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True

    MsgBox "Actualisation terminee !" & vbCrLf & vbCrLf & _
           totalImport & " dossier(s) En suspens importes." & vbCrLf & _
           nbAnalystes & " analyste(s) detectes automatiquement." & vbCrLf & _
           "Raisons et commentaires conserves.", _
           vbInformation, "Suivi Suspens SGCI"
    Exit Sub

ErrHandler:
    On Error Resume Next
    If Not conn Is Nothing Then
        If conn.State = 1 Then conn.Close
    End If
    wsCfg.Range("B4").Value = "Erreur : " & Err.Description
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
    MsgBox "Erreur (n " & Err.Number & ") :" & vbCrLf & vbCrLf & _
           Err.Description & vbCrLf & vbCrLf & _
           "Verifications :" & vbCrLf & _
           "  - Etes-vous connecte au lecteur S:\" & vbCrLf & _
           "  - Le fichier Access n est pas ouvert en mode exclusif" & vbCrLf & _
           "  - Microsoft Access est installe sur ce poste", _
           vbCritical, "Erreur"

Cleanup:
    On Error Resume Next
    If Not rsAn Is Nothing Then If rsAn.State = 1 Then rsAn.Close
    If Not rs   Is Nothing Then If rs.State   = 1 Then rs.Close
    If Not conn Is Nothing Then If conn.State = 1 Then conn.Close
    Set rsAn = Nothing : Set rs = Nothing : Set conn = Nothing
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
End Sub

Sub ConfigurerCheminAccess()
    Dim sPath As String
    Dim wsCfg As Worksheet
    Set wsCfg = ThisWorkbook.Sheets(1)

    sPath = InputBox("Entrez le chemin complet du fichier Access :" & vbCrLf & vbCrLf & _
                     "Exemple : S:\dossier\base.accdb" & vbCrLf & vbCrLf & _
                     "Chemin actuel : " & wsCfg.Range("B1").Value, _
                     "Configurer le chemin Access", wsCfg.Range("B1").Value)

    If sPath = "" Then Exit Sub

    If Dir(sPath) = "" Then
        If MsgBox("Fichier non trouve : " & sPath & vbCrLf & _
                  "Enregistrer quand meme ?", vbYesNo + vbQuestion) = vbNo Then Exit Sub
    End If

    wsCfg.Range("B1").Value = sPath
    MsgBox "Chemin enregistre. Cliquez sur ACTUALISER pour tester.", vbInformation
End Sub

' -- Diagnostic : affiche les providers OLEDB disponibles ----
Sub DiagnosticProviders()
    Dim cn As Object
    Set cn = CreateObject("ADODB.Connection")
    Dim cat As Object
    Set cat = CreateObject("ADOX.Catalog")

    Dim msg As String
    msg = "Providers ACE/Jet disponibles sur ce poste :" & vbCrLf & vbCrLf

    Dim providers(3) As String
    providers(0) = "Microsoft.ACE.OLEDB.16.0"
    providers(1) = "Microsoft.ACE.OLEDB.12.0"
    providers(2) = "Microsoft.Jet.OLEDB.4.0"

    Dim p As Integer
    For p = 0 To 2
        On Error Resume Next
        Err.Clear
        cn.Open "Provider=" & providers(p) & ";Data Source=C:\test.accdb;"
        If Err.Number = 0 Or InStr(Err.Description, "trouve") > 0 Or _
           InStr(Err.Description, "found") > 0 Then
            msg = msg & "  OK  -> " & providers(p) & vbCrLf
        Else
            msg = msg & "  X   -> " & providers(p) & " (" & Err.Description & ")" & vbCrLf
        End If
        On Error GoTo 0
        If cn.State = 1 Then cn.Close
    Next p

    MsgBox msg, vbInformation, "Diagnostic Providers"
End Sub
