Public Sub UpdateDatabaseField(fieldName As String, fieldValue As Variant)
    Dim IDValue As String
    IDValue = Nz(Forms!Form_5_MODIFICATIONS!Texte162.Value, "")
    
    If Len(IDValue) > 0 Then
        CurrentDb.Execute "UPDATE DATABASE SET [" & fieldName & "] = " & fieldValue & " WHERE [IDSG] = '" & Replace(IDValue, "'", "''") & "'"
    End If
End Sub


Private Sub Option373_AfterUpdate()
    Call UpdateDatabaseField("FAST", Me.Option373)
End Sub


Public Sub Update_FAST()
    Dim IDValue As String
    IDValue = Nz(Me.Texte162.Value, "")
    Me.Option373 = Nz(DLookup("[FAST]", "DATABASE", "[IDSG]='" & Replace(IDValue, "'", "''") & "'"), False)
End Sub


Forms("5_MODIFICATIONS").Update_FAST

If Len(IDValue) > 0 Then
    If IsNumeric(fieldValue) Or VarType(fieldValue) = vbBoolean Then
        CurrentDb.Execute "UPDATE DATABASE SET [" & fieldName & "] = " & IIf(fieldValue, -1, 0) & " WHERE [IDSG] = '" & Replace(IDValue, "'", "''") & "'"
    Else
        CurrentDb.Execute "UPDATE DATABASE SET [" & fieldName & "] = '" & fieldValue & "' WHERE [IDSG] = '" & Replace(IDValue, "'", "''") & "'"
    End If
End If
